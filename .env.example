# Copy to .env and fill in. docker-compose.yml already targets the services that
# are up on this host, so the password is usually the only thing you must set.

# Postgres — this app reuses trAIner's database (`trainer-db`, on trAIner's
# compose network) and creates its own `technique` schema inside it; nothing
# outside that schema is touched. Same password trAIner's compose uses.
# URL-encode it if it contains @ : / ? #.
POSTGRES_PASSWORD=
# Override only if you want a different database than trAIner's:
# POSTGRES_USER=arturo
# POSTGRES_HOST=trainer-db
# POSTGRES_DB=trainer_db

# Redis — the shared instance on `infra_network`, on databases 3/4/5 so they
# never collide with the ones trAIner uses. Override to point somewhere else.
# CELERY_BROKER_URL=redis://redis:6379/3
# CELERY_RESULT_BACKEND=redis://redis:6379/4
# REDIS_URL=redis://redis:6379/5

# Torch device for pose inference. Empty = auto-detect (CUDA if available).
# SynthPose is a ViT-Huge: it runs on CPU, but slowly — a GPU is recommended
# (uncomment the GPU block in docker-compose.yml).
DEVICE=

# Frames per YOLO forward pass during person detection.
YOLO_BATCH_SIZE=8
